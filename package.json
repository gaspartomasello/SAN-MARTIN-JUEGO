{
  "name": "clarin-de-san-lorenzo",
  "version": "0.1.0",
  "description": "FPS histórico de la Batalla de San Lorenzo (1813) en three.js. Fase 1: el campo de tiro.",
  "type": "module",
  "private": true,
  "scripts": {
    "jugar": "npm run empaquetar && node herramientas/abrir.mjs",
    "sincronizar": "node herramientas/sincronizar.mjs",
    "servir": "python3 -m http.server 8099",
    "ritmo": "node pruebas/ritmo.mjs",
    "rendimiento": "node pruebas/rendimiento.mjs",
    "capturas": "node pruebas/capturas.mjs",
    "empaquetar": "node herramientas/empaquetar.mjs",
    "archivo-unico": "node pruebas/archivo-unico.mjs",
    "sala": "node herramientas/servidor.mjs",
    "red": "node pruebas/red.mjs",
    "moral": "node pruebas/moral.mjs",
    "desbande": "node pruebas/desbande.mjs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "1.49.1"
  }
}
